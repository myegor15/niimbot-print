{
  "name": "niim-print-server",
  "version": "1.0.0",
  "private": true,
  "description": "Niimbot printer REST server (niimblue-node)",
  "scripts": {
    "start": "niimblue-cli server -h 0.0.0.0 -p 5010"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mmote/niimblue-node": "^1.1.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "usb@2.18.0": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "@serialport/bindings-cpp@12.0.1": true,
    "@stoprocent/bluetooth-hci-socket@2.3.0": true,
    "@stoprocent/noble@2.6.5": true
  }
}
