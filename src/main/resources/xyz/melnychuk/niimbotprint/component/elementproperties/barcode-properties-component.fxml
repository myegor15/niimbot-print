<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="xyz.melnychuk.niimbotprint.controller.component.elementproperties.BarcodePropertiesComponentController"
      spacing="8">
    <HBox spacing="8">
        <Label text="%label.content"/>
        <TextField fx:id="contentField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="8">
        <Label text="%label.width"/>
        <Spinner fx:id="widthSpinner" editable="true" prefWidth="120"/>
    </HBox>
    <HBox spacing="8">
        <Label text="%label.height"/>
        <Spinner fx:id="heightSpinner" editable="true" prefWidth="120"/>
    </HBox>
    <HBox spacing="8">
        <Label text="%label.showValue"/>
        <CheckBox fx:id="showValueCheck"/>
    </HBox>
</VBox>
