<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="xyz.melnychuk.niimbotprint.controller.component.PrintSettingsComponentController"
      spacing="8" styleClass="panel">
    <Label text="Печать" styleClass="panel-title"/>
    <GridPane hgap="6" vgap="6">
        <Label text="Плотность" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Spinner fx:id="densitySpinner" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
        <Label text="Количество" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="quantitySpinner" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
        <Label text="Направление" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="directionCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="90"/>
    </GridPane>
    <Button fx:id="printButton" text="Печать" maxWidth="Infinity" disable="true" onAction="#onPrint"/>
</VBox>
