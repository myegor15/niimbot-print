<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="xyz.melnychuk.niimbotprint.controller.component.PrinterComponentController"
      spacing="8" styleClass="panel">
    <Label text="%panel.printer" styleClass="panel-title"/>
    <HBox spacing="4">
        <Button fx:id="refreshButton" onAction="#onRefresh" styleClass="icon-button">
            <graphic>
                <FontIcon iconLiteral="mdi2r-refresh" iconSize="18"/>
            </graphic>
            <tooltip>
                <Tooltip text="%tooltip.refresh"/>
            </tooltip>
        </Button>
        <ComboBox fx:id="deviceComboBox" prefWidth="150" onAction="#onDeviceSelected"/>
        <Button fx:id="disconnectButton" onAction="#onDisconnect" styleClass="icon-button"
                visible="false" managed="false">
            <graphic>
                <FontIcon iconLiteral="mdi2p-power-settings" iconSize="18"/>
            </graphic>
            <tooltip>
                <Tooltip text="%tooltip.disconnect"/>
            </tooltip>
        </Button>
    </HBox>
    <TextArea fx:id="printerInfoArea" editable="false" wrapText="true" prefHeight="220" prefWidth="210"/>
</VBox>
