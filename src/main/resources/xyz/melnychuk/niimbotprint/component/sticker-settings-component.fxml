<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="xyz.melnychuk.niimbotprint.controller.component.StickerSettingsComponentController"
      spacing="8" minWidth="230" styleClass="panel">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Стикер" styleClass="panel-title"/>
    <HBox spacing="5">
        <Button text="Новая" onAction="#onNew"/>
        <Button text="Открыть" onAction="#onOpen"/>
        <Button text="Сохранить" onAction="#onSave"/>
    </HBox>
    <GridPane hgap="6" vgap="6">
        <Label text="Ширина, px" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Spinner fx:id="widthSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
        <Label text="Высота, px" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="heightSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
    </GridPane>
</VBox>
