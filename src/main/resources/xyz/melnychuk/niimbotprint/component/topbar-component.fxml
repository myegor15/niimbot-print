<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>

<ToolBar xmlns:fx="http://javafx.com/fxml" fx:controller="xyz.melnychuk.niimbotprint.controller.component.TopBarComponentController">
    <Label text="Сервер:"/>
    <TextField fx:id="serverField" editable="false" prefWidth="180" text="..."/>
    <Button fx:id="scanButton" text="Поиск" onAction="#onScan"/>
    <ComboBox fx:id="deviceCombo" prefWidth="220"/>
    <Button fx:id="connectButton" text="Подключить" onAction="#onConnect"/>
    <Button fx:id="disconnectButton" text="Отключить" onAction="#onDisconnect"/>
</ToolBar>
