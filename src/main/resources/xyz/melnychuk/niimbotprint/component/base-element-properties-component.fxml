<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="xyz.melnychuk.niimbotprint.controller.component.BaseElementPropertiesComponentController"
      fx:id="propertiesBox" minWidth="200" spacing="8" styleClass="panel">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Свойства" styleClass="panel-title"/>
    <Label text="Позиция"/>
    <HBox spacing="8">
        <Label text="X" prefWidth="40"/>
        <Spinner fx:id="xSpinner" editable="true" prefWidth="120"/>
    </HBox>
    <HBox spacing="8">
        <Label text="Y" prefWidth="40"/>
        <Spinner fx:id="ySpinner" editable="true" prefWidth="120"/>
    </HBox>
    <VBox fx:id="propertyBox" spacing="8"/>
</VBox>
