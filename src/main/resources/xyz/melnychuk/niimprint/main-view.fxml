<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="xyz.melnychuk.niimprint.controller.MainController">
    <top>
        <ToolBar>
            <Label text="Сервер:"/>
            <TextField fx:id="serverField" editable="false" prefWidth="180" text="..."/>
            <Button fx:id="scanButton" text="Поиск" onAction="#onScan"/>
            <ComboBox fx:id="deviceCombo" prefWidth="220"/>
            <Button fx:id="connectButton" text="Подключить" onAction="#onConnect"/>
            <Button fx:id="disconnectButton" text="Отключить" onAction="#onDisconnect"/>
            <Separator/>
            <Button text="Новая" onAction="#onNew"/>
            <Button text="Открыть" onAction="#onOpen"/>
            <Button text="Сохранить" onAction="#onSave"/>
            <Separator/>
            <Button fx:id="printButton" text="Печать" onAction="#onPrint"/>
        </ToolBar>
    </top>

    <left>
        <VBox spacing="8" minWidth="230" styleClass="panel">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Этикетка" styleClass="panel-title"/>
            <GridPane hgap="6" vgap="6">
                <Label text="Ширина, px" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Spinner fx:id="widthSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
                <Label text="Высота, px" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="heightSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
                <Label text="Плотность" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Spinner fx:id="densitySpinner" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
                <Label text="Количество" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="quantitySpinner" GridPane.rowIndex="3" GridPane.columnIndex="1" editable="true" prefWidth="90"/>
                <Label text="Направление" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="directionCombo" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="90"/>
            </GridPane>
            <Separator/>
            <Label text="Элементы" styleClass="panel-title"/>
            <Button text="+ Текст" maxWidth="Infinity" onAction="#onAddText"/>
            <Button text="+ Штрихкод" maxWidth="Infinity" onAction="#onAddBarcode"/>
            <Button text="+ Изображение" maxWidth="Infinity" onAction="#onAddImage"/>
            <Button fx:id="deleteButton" text="Удалить" maxWidth="Infinity" onAction="#onDelete"/>
            <Separator/>
            <Label text="Принтер" styleClass="panel-title"/>
            <TextArea fx:id="printerInfoArea" editable="false" wrapText="true" prefHeight="220" prefWidth="210"/>
        </VBox>
    </left>

    <center>
        <ScrollPane>
            <StackPane fx:id="canvasHost" styleClass="canvas-host"/>
        </ScrollPane>
    </center>

    <right>
        <VBox fx:id="propertiesBox" minWidth="200" spacing="8" styleClass="panel">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Свойства" styleClass="panel-title"/>
        </VBox>
    </right>

    <bottom>
        <HBox spacing="12" styleClass="status-bar">
            <padding>
                <Insets top="4" right="8" bottom="4" left="8"/>
            </padding>
            <Label fx:id="connectionLabel" text="Не подключено"/>
            <Label fx:id="messageLabel" text="Готово"/>
        </HBox>
    </bottom>
</BorderPane>
